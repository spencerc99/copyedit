---
import Card from '../components/Card.astro';
const tagline = "Websites as places — café ☕ hours only";
const items = ["Shrines", "Sculptures", "Shared cursors"];
---
<html lang="en">
  <head><meta charset="utf-8" /><title>copyedit · astro</title></head>
  <body style="font-family: Georgia, serif; max-width: 560px; margin: 48px auto; line-height: 1.5">
    <h1>Astro example 🌱</h1>
    <p>{tagline}</p>
    <Card title="Things I make">
      <p>Here is some slotted text inside a card.</p>
    </Card>
    <ul>{items.map((i) => <li>{i}</li>)}</ul>
  </body>
</html>
